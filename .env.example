# Read by src/geoqc/interfaces/api/main.py when the optional FastAPI app is served.
# Not used by the core library or the CLI.

# "development" (default) exposes the interactive API docs at /docs, /redoc, and
# /openapi.json. Set to "production" to disable all three before deploying the API
# beyond localhost.
GEOQC_ENVIRONMENT=development

# Standard library logging level applied via logging.basicConfig at API startup.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
GEOQC_LOG_LEVEL=INFO

# Authentication is disabled only for local development. Production defaults
# to enabled and refuses startup without at least one 16+ character secret.
GEOQC_AUTH_ENABLED=false
GEOQC_API_KEYS=
GEOQC_BEARER_TOKENS=

# Process-local limits; use shared enforcement when running multiple workers.
GEOQC_RATE_LIMIT_REQUESTS=120
GEOQC_RATE_LIMIT_EXPENSIVE_REQUESTS=20
GEOQC_RATE_LIMIT_WINDOW_SECONDS=60

GEOQC_MAX_UPLOAD_BYTES=104857600
GEOQC_MAX_FEATURES=1000000
GEOQC_MAX_REPORTED_FEATURES=1000
GEOQC_MAX_REPAIR_FEATURES=50000
GEOQC_STREAMING_CHUNK_SIZE=16384
GEOQC_TEMPORARY_DIRECTORY=

# Jobs are process-local and non-durable.
GEOQC_ASYNC_THRESHOLD_BYTES=10485760
GEOQC_JOB_WORKERS=2
GEOQC_JOB_RETENTION_SECONDS=3600
GEOQC_METRICS_ENABLED=true
