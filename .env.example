# Read by src/geoqc/interfaces/api/main.py when the optional FastAPI app is served.
# Not used by the core library or the CLI.

# "development" (default) exposes the interactive API docs at /docs, /redoc, and
# /openapi.json. Set to "production" to disable all three before deploying the API
# beyond localhost.
GEOQC_ENVIRONMENT=development

# Standard library logging level applied via logging.basicConfig at API startup.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
GEOQC_LOG_LEVEL=INFO
